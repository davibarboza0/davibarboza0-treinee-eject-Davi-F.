{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src/scripts",
    "outDir": "./src/scripts",
    "removeComments": true,
    "noEmitOnError": false,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2017"]
  },
  "include": ["src/scripts/**/*.ts"],
  "exclude": ["node_modules"]
}